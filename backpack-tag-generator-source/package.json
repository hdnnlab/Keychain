{
  "name": "backpack-tag-generator",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "css": "tailwindcss -c tailwind.config.js -i tw.css -o app.css --minify",
    "js": "esbuild src/app.js --bundle --minify --format=iife --outfile=app.js",
    "build": "npm run css && npm run js"
  },
  "dependencies": {
    "clipper-lib": "^6.4.2",
    "jszip": "^3.10.1",
    "opentype.js": "^2.0.0",
    "three": "0.128.0"
  },
  "devDependencies": { "esbuild": "^0.21.0", "tailwindcss": "^3.4.17" }
}
